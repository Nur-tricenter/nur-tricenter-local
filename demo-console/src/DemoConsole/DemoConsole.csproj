<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DemoConsole</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same-origin proxy to the gateway, Consul and the RabbitMQ management API (no CORS needed). -->
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
    <!-- Own exclusive queue bound to every fanout exchange: a copy of each event, nothing stolen. -->
    <PackageReference Include="RabbitMQ.Client" Version="7.1.2" />
    <!-- Read-only queries for outbox/inbox tables and the gap X-17 lookups. -->
    <PackageReference Include="Npgsql" Version="9.0.3" />
  </ItemGroup>

</Project>

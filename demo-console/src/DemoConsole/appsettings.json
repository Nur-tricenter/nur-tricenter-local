{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Upstreams": {
    "Gateway": "http://localhost:15005",
    "Consul": "http://localhost:8500",
    "RabbitManagement": "http://localhost:15672"
  },

  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "TapQueue": "demo-console.tap",
    "Exchanges": [
      "user-published", "user-updated", "paciente-published",
      "food-published", "food-nutritional-info-updated", "recipe-published", "recipe-updated", "meal-plan-published",
      "package-validated",
      "courier-created", "courier-status-changed", "route-created", "courier-assigned-to-route", "delivery-added-to-route",
      "route-started", "route-completed", "route-cancelled", "delivery-completed", "delivery-failed"
    ]
  },

  "Postgres": {
    "Server": "Host=localhost;Port=5433;Username=dev-only;Password=dev-only-password;Timeout=5;Command Timeout=5",
    "Databases": {
      "identity": "nur_tricenter_identity",
      "ms1": "ms1_clinica_nutricional",
      "ms2": "ms2-plans-and-recipes-catalog",
      "ms3": "nur_tricenter_contracting",
      "ms4": "ms4_delivery_calendar",
      "ms5": "ms5_logistics"
    }
  }
}
